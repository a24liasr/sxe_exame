# This file is a template, and might need editing before it works on your project.
# see https://docs.gitlab.com/ee/ci/yaml/README.html for all available options

# you can delete this line if you're not using Docker

stages:
  - corregir
  - enviar

variables:
 NOTA_FILE: ./nota.txt
 REPORT_FILE: ./report.txt

#La imagen de corrección correspondiente (con crudini instalado y todo lo necesario)
image: javierfpisc/sxe_ex_primera:latest

#Job corregirexamen
corregirexamen:
 stage: corregir
 variables:
   NUMEJERCICIOS: "18"
  # rules:
  #   - exists:      
 before_script:
    #Obtenemos los tests del repositorio de tests y de la rama correspondiente
   - git clone -b sxe_ex_primera https://javierfpisc:$REPO_TESTS_TOKEN@github.com/javierfpisc/examenes_tests $CI_PROJECT_DIR/tests_examen
 script:
   - echo "Corrigiendo examen..."
   - echo "export NOTA=0" > $NOTA_FILE
   # NOTA: test.sh está dentro del container y ejecuta los comandos en /var/tests.ini
   - for ((i=1;i<=NUMEJERCICIOS;i++));do source $NOTA_FILE && test.sh test${i};done
   - cat $NOTA_FILE
   - cat $REPORT_FILE
 artifacts:
   paths:
    - $NOTA_FILE
    - $REPORT_FILE
  # Restricciones (si es necesario)
  # only:
  #  changes:
  #  refs:
  #  variables:

#Job crearissues con la nota
crearissue:
  stage: enviar
  # rules:
  #   - exists:
  script:
    - NOTA=$(cat $NOTA_FILE | cut -d' ' -f2)
    - REPORT="$(cat $REPORT_FILE)<p/><p>MD5 entrega:$(tar -cf - $CI_PROJECT_DIR/entrega | md5sum)</p>"
    - curl --request POST --header "PRIVATE-TOKEN:$TOKEN" --data "title=NOTA%20$CI_PROJECT_TITLE%20$NOTA&description=$REPORT" $API_URL/projects/$ISSUES_PROJECT/issues
  artifacts:
   paths:
    - $NOTA_FILE
    - $REPORT_FILE 
  # Restricciones (si es necesario) 
  # only:
  #  changes:
  #  refs:
  #  variables:
#Job restringir, establece el rol del alumno del proyecto a GUEST
restringir:
  stage: enviar
  # rules:
  #   - exists:
  script:
    - USERID=$(curl --request GET --header PRIVATE-TOKEN:$TOKEN $API_URL/users?username=$CI_PROJECT_NAME | jq '.[].id')
    - PPATH=$(echo $CI_PROJECT_PATH | sed -e 's/\//%2F/')
    - curl --request PUT --header PRIVATE-TOKEN:$TOKEN $API_URL/projects/$PPATH/members/$USERID?access_level=10
 
